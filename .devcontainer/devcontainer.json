{
  "name": "RockULA .NET 10",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/copilot-cli:1": {},
    "ghcr.io/geraskin/ai-workspace/opencode:0.1.0": {
      "version": "2.1.1"
    }
  },
  "remoteUser": "vscode",
  "workspaceFolder": "/repos/rockula",
  "workspaceMount": "source=R:\\repos\\rockula,target=/repos,type=bind,consistency=cached",
  "mounts": [
    "source=${localEnv:USERPROFILE}\\.agents,target=/home/alexey/.agents,type=bind,readonly",
    "source=${localWorkspaceFolderBasename}-copilot-state,target=/home/vscode/.copilot,type=volume",
    "source=${localWorkspaceFolderBasename}-opencode-data,target=/home/vscode/.local/share/opencode,type=volume",
    "source=${localWorkspaceFolderBasename}-opencode-config,target=/home/vscode/.config/opencode,type=volume",
    "source=${localWorkspaceFolderBasename}-opencode-state,target=/home/vscode/.local/state/opencode,type=volume"
  ],
  "shutdownAction": "none",
  "updateRemoteUserUID": true,
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "redhat.vscode-yaml",
        "mhutchie.git-graph",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "vizards.deepseek-v4-for-copilot"
      ]
    }
  },
  "postCreateCommand": "git config --global 'credential.https://github.com/Geraskin/rockula.git.useHttpPath' true && git config --global 'credential.https://github.com/Geraskin/rockula.git.helper' 'cache --timeout=3600' && dotnet restore RockULA.slnx"
}
